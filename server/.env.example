# Copy this file to server/.env and fill in real values before deploying.

# Port the API server listens on.
PORT=4000

# Generate with: node server/scripts/hash-password.js "your-new-password"
# If unset, falls back to a default password (ssctvet-admin-2026) — fine for
# local testing, NOT fine for a public deployment.
ADMIN_PASSWORD_HASH=$2b$10$j5UeKsipDJwaqfFYu9n81e58N5haxMvmf3EFBCIHZeQEGV0YyUAtu

# Any long random string. If unset, a random one is generated at each server
# start, which logs every admin out whenever the server restarts.
JWT_SECRET=7e8f5cfa2b918d3e410a56bc74d8e9f2a0b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7


# Only needed if the frontend is hosted on a different domain than this API
# (e.g. frontend on Netlify, API on Railway). Leave unset for same-origin
# deployments, where this server also serves the built frontend.
ALLOWED_ORIGIN=
